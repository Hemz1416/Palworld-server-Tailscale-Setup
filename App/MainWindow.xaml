<Window x:Class="HemzPalworldConnectionSetup.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Hemz Tailscale Connection Setup"
        Height="820" Width="940"
        WindowStartupLocation="CenterScreen"
        Background="#0B0D13" Foreground="#F3F4F6"
        FontFamily="Segoe UI"
        ResizeMode="CanResizeWithGrip">

    <Window.Resources>
        <Style x:Key="ActionButton" TargetType="Button">
            <Setter Property="Background" Value="#1E2333"/>
            <Setter Property="Foreground" Value="#E5E7EB"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Padding" Value="14,10"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#2D354D"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#2A324A"/>
                    <Setter Property="BorderBrush" Value="#3B82F6"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="PrimaryConnectButton" TargetType="Button">
            <Setter Property="Background" Value="#059669"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="Padding" Value="24,12"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#10B981"/>
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Background" Value="#374151"/>
                    <Setter Property="Foreground" Value="#9CA3AF"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="#141824" CornerRadius="10" Padding="18" BorderBrush="#242B42" BorderThickness="1" Margin="0,0,0,16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock Name="TxtHeaderTitle" Text="HEMZ TAILSCALE CONNECTION SETUP" FontWeight="Bold" FontSize="22" Foreground="#60A5FA"/>
                    <TextBlock Name="TxtHeaderSubtitle" Text="Private Tailscale Connection to the Shared Server Machine" Foreground="#94A3B8" FontSize="13" Margin="0,4,0,0"/>
                </StackPanel>
                <StackPanel Grid.Column="1" VerticalAlignment="Center" Orientation="Horizontal">
                    <Border Name="BadgeTailscale" Background="#374151" CornerRadius="12" Padding="12,5" Margin="0,0,8,0">
                        <TextBlock Name="TxtBadgeTailscale" Text="● Tailscale: Checking..." FontWeight="SemiBold" FontSize="12" Foreground="#D1D5DB"/>
                    </Border>
                    <Border Name="BadgeServer" Background="#374151" CornerRadius="12" Padding="12,5">
                        <TextBlock Name="TxtBadgeServer" Text="● Host PC: Searching..." FontWeight="SemiBold" FontSize="12" Foreground="#D1D5DB"/>
                    </Border>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Auth Alert Banner (visible when Tailscale machine share invitation sign-in needed) -->
        <Border Grid.Row="1" Name="BannerAuthRequired" Background="#7F1D1D" BorderBrush="#EF4444" BorderThickness="1" CornerRadius="8" Padding="16" Margin="0,0,0,16" Visibility="Collapsed">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock Text="SHARED MACHINE INVITATION AUTHENTICATION REQUIRED" FontWeight="Bold" FontSize="14" Foreground="#FCA5A5"/>
                    <TextBlock Text="1. A browser window has been opened.&#x0a;2. Accept the Hemz shared machine invitation.&#x0a;3. Complete Tailscale sign-in with your account.&#x0a;4. Return to this application." Foreground="#FEE2E2" FontSize="12" Margin="0,6,0,0"/>
                </StackPanel>
                <Button Grid.Column="1" Content="Open Invite in Browser" Click="BtnOpenInvite_Click" Background="#DC2626" Foreground="White" FontWeight="Bold" Padding="14,8" VerticalAlignment="Center" Cursor="Hand" BorderThickness="0">
                    <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="6"/></Style></Button.Resources>
                </Button>
            </Grid>
        </Border>

        <!-- Main Content Area -->
        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <!-- Game Selection Card -->
                <Border Background="#141824" CornerRadius="8" Padding="16,12" Margin="0,0,0,16" BorderBrush="#2563EB" BorderThickness="1.5">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                            <TextBlock Text="TARGET GAME SERVER" FontWeight="Bold" FontSize="13" Foreground="#60A5FA"/>
                            <TextBlock Text="Choose which dedicated game server to connect to:" Foreground="#94A3B8" FontSize="12" Margin="0,2,0,0"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <RadioButton Name="RadioMinecraft" Content="⛏️  Minecraft: Java (Port 25565)" GroupName="GameGroup" IsChecked="True" Checked="GameSelection_Changed" Foreground="#F3F4F6" FontWeight="SemiBold" FontSize="13" Margin="0,0,18,0" Cursor="Hand" VerticalAlignment="Center"/>
                            <RadioButton Name="RadioPalworld" Content="🐾  Palworld (Port 8211)" GroupName="GameGroup" Checked="GameSelection_Changed" Foreground="#F3F4F6" FontWeight="SemiBold" FontSize="13" Cursor="Hand" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Overview Cards Grid -->
                <Grid Margin="0,0,0,16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Network Card -->
                    <Border Grid.Column="0" Background="#141824" CornerRadius="8" Padding="16" Margin="0,0,8,0" BorderBrush="#22283A" BorderThickness="1">
                        <StackPanel>
                            <TextBlock Text="TAILSCALE CLIENT STATUS" FontWeight="Bold" FontSize="12" Foreground="#94A3B8" Margin="0,0,0,12"/>
                            
                            <Grid Margin="0,0,0,6">
                                <TextBlock Text="Tailscale CLI:" Foreground="#9CA3AF" FontSize="13"/>
                                <TextBlock Name="TxtClientStatus" Text="Detecting..." HorizontalAlignment="Right" FontWeight="SemiBold" Foreground="#F3F4F6"/>
                            </Grid>
                            <Grid Margin="0,0,0,6">
                                <TextBlock Text="Windows Service:" Foreground="#9CA3AF" FontSize="13"/>
                                <TextBlock Name="TxtServiceStatus" Text="Checking..." HorizontalAlignment="Right" FontWeight="SemiBold" Foreground="#F3F4F6"/>
                            </Grid>
                            <Grid Margin="0,0,0,6">
                                <TextBlock Text="Local Tailscale IP:" Foreground="#9CA3AF" FontSize="13"/>
                                <TextBlock Name="TxtLocalIp" Text="-" HorizontalAlignment="Right" FontFamily="Consolas" Foreground="#38BDF8"/>
                            </Grid>
                            <Grid Margin="0,0,0,6">
                                <TextBlock Text="Connection Path:" Foreground="#9CA3AF" FontSize="13"/>
                                <TextBlock Name="TxtConnectionPath" Text="-" HorizontalAlignment="Right" FontWeight="SemiBold" Foreground="#F3F4F6"/>
                            </Grid>
                            <Grid Margin="0,0,0,0">
                                <TextBlock Text="Tailscale Latency:" Foreground="#9CA3AF" FontSize="13"/>
                                <TextBlock Name="TxtLatency" Text="-" HorizontalAlignment="Right" FontWeight="SemiBold" Foreground="#34D399"/>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- Server Card -->
                    <Border Grid.Column="1" Background="#141824" CornerRadius="8" Padding="16" Margin="8,0,0,0" BorderBrush="#22283A" BorderThickness="1">
                        <StackPanel>
                            <TextBlock Text="SHARED SERVER MACHINE DETAILS" FontWeight="Bold" FontSize="12" Foreground="#94A3B8" Margin="0,0,0,12"/>

                            <Grid Margin="0,0,0,6">
                                <TextBlock Text="Server Name:" Foreground="#9CA3AF" FontSize="13"/>
                                <TextBlock Name="TxtServerName" Text="Hemz Game Server" HorizontalAlignment="Right" FontWeight="Bold" Foreground="#60A5FA"/>
                            </Grid>
                            <Grid Margin="0,0,0,6">
                                <TextBlock Text="Shared Machine:" Foreground="#9CA3AF" FontSize="13"/>
                                <TextBlock Name="TxtServerDevice" Text="-" HorizontalAlignment="Right" Foreground="#F3F4F6"/>
                            </Grid>
                            <Grid Margin="0,0,0,6">
                                <TextBlock Text="Server Address:" Foreground="#9CA3AF" FontSize="13"/>
                                <TextBlock Name="TxtServerAddress" Text="Discovering..." HorizontalAlignment="Right" FontWeight="Bold" FontFamily="Consolas" Foreground="#38BDF8"/>
                            </Grid>
                            <Grid Margin="0,0,0,0">
                                <TextBlock Name="LblPortDiag" Text="Port Diagnostic:" Foreground="#9CA3AF" FontSize="13"/>
                                <TextBlock Name="TxtUdpPort" Text="-" HorizontalAlignment="Right" FontSize="11" Foreground="#94A3B8" TextTrimming="CharacterEllipsis"/>
                            </Grid>
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- Credentials Card (Visible for Palworld / password-protected servers) -->
                <Border Name="CardCredentials" Background="#141824" CornerRadius="8" Padding="16" Margin="0,0,0,16" BorderBrush="#22283A" BorderThickness="1" Visibility="Collapsed">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="SERVER CREDENTIALS" FontWeight="Bold" FontSize="12" Foreground="#94A3B8" Margin="0,0,0,8"/>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="Password: " Foreground="#9CA3AF" VerticalAlignment="Center" FontSize="13"/>
                                <TextBlock Name="TxtPasswordMasked" Text="••••••••••••" FontWeight="Bold" FontFamily="Consolas" FontSize="15" Foreground="#FBBF24" VerticalAlignment="Center" Margin="8,0,12,0"/>
                                <Button Name="BtnTogglePassword" Content="Show" Click="BtnTogglePassword_Click" Background="#242B42" Foreground="#D1D5DB" Padding="8,3" FontSize="11" Cursor="Hand" BorderThickness="0" Margin="0,0,8,0">
                                    <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="4"/></Style></Button.Resources>
                                </Button>
                                <Button Content="Copy Server Password" Click="BtnCopyPassword_Click" Background="#242B42" Foreground="#FDE68A" Padding="8,3" FontSize="11" Cursor="Hand" BorderThickness="0">
                                    <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="4"/></Style></Button.Resources>
                                </Button>
                            </StackPanel>
                            <TextBlock Text="Notice: Anyone possessing this EXE may potentially recover an embedded password." Foreground="#64748B" FontSize="11" Margin="0,6,0,0"/>
                            <CheckBox Name="ChkRememberPassword" Content="Remember server password locally" Foreground="#9CA3AF" FontSize="11" Margin="0,6,0,0" Checked="ChkRememberPassword_Changed" Unchecked="ChkRememberPassword_Changed"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Game Client Card -->
                <Border Background="#141824" CornerRadius="8" Padding="16" Margin="0,0,0,16" BorderBrush="#22283A" BorderThickness="1">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Name="LblGameClient" Text="MINECRAFT GAME CLIENT" FontWeight="Bold" FontSize="12" Foreground="#94A3B8" Margin="0,0,0,6"/>
                            <TextBlock Name="TxtGameClientPath" Text="Ready to connect" Foreground="#D1D5DB" FontSize="13" TextTrimming="CharacterEllipsis"/>
                        </StackPanel>
                        <Button Name="BtnBrowseGame" Grid.Column="1" Content="Browse Launcher" Click="BtnBrowseGame_Click" Style="{StaticResource ActionButton}" Padding="10,6" FontSize="12" VerticalAlignment="Center"/>
                    </Grid>
                </Border>

                <!-- Progress Bar -->
                <ProgressBar Name="ProgressBarAction" Height="4" Background="#1A1D27" Foreground="#3B82F6" BorderThickness="0" Margin="0,0,0,12" IsIndeterminate="False"/>
            </StackPanel>
        </ScrollViewer>

        <!-- Primary Action Area -->
        <Border Grid.Row="3" Background="#141824" CornerRadius="8" Padding="16" Margin="0,16,0,16" BorderBrush="#22283A" BorderThickness="1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <TextBlock Text="READY TO PLAY" FontWeight="Bold" FontSize="14" Foreground="#10B981"/>
                    <TextBlock Name="TxtReadySubtitle" Text="Click Connect to copy the server address and view in-game connection steps." Foreground="#9CA3AF" FontSize="12" Margin="0,2,0,0"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button Name="BtnCopyAddress" Content="Copy Server Address" Click="BtnCopyAddress_Click" Style="{StaticResource ActionButton}" Margin="0,0,10,0"/>
                    <Button Name="BtnConnectGame" Content="CONNECT TO MINECRAFT" Click="BtnConnectGame_Click" Style="{StaticResource PrimaryConnectButton}"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Secondary Toolbar -->
        <Grid Grid.Row="4">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                <Button Content="Test Connection" Click="BtnTestConnection_Click" Style="{StaticResource ActionButton}" Margin="0,0,8,0"/>
                <Button Content="Troubleshoot" Click="BtnTroubleshoot_Click" Style="{StaticResource ActionButton}" Margin="0,0,8,0"/>
                <Button Content="Reinstall Tailscale" Click="BtnReinstallTailscale_Click" Style="{StaticResource ActionButton}" Margin="0,0,8,0"/>
                <Button Content="Open Log" Click="BtnOpenLog_Click" Style="{StaticResource ActionButton}"/>
            </StackPanel>
            <Button Content="Exit" Click="BtnExit_Click" Style="{StaticResource ActionButton}" HorizontalAlignment="Right" Padding="20,10"/>
        </Grid>
    </Grid>
</Window>
