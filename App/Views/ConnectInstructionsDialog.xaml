<Window x:Class="HemzPalworldConnectionSetup.Views.ConnectInstructionsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="How to Connect in Palworld"
        Height="540" Width="680"
        WindowStartupLocation="CenterOwner"
        Background="#0F1117" Foreground="#F3F4F6"
        FontFamily="Segoe UI"
        ResizeMode="NoResize">

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="#1A1D27" CornerRadius="8" Padding="16" BorderBrush="#2563EB" BorderThickness="1.5">
            <StackPanel>
                <TextBlock Text="CONNECTING TO HEMZ PALWORLD" FontWeight="Bold" FontSize="20" Foreground="#60A5FA"/>
                <TextBlock Text="Server address has been automatically copied to your clipboard!" Foreground="#34D399" FontWeight="SemiBold" FontSize="13" Margin="0,4,0,0"/>
            </StackPanel>
        </Border>

        <!-- Step-by-Step Instructions -->
        <Border Grid.Row="1" Background="#161923" CornerRadius="8" Padding="20" Margin="0,16,0,16" BorderBrush="#242938" BorderThickness="1">
            <StackPanel>
                <TextBlock Text="In-Game Connection Steps:" FontWeight="Bold" FontSize="15" Foreground="#F9FAFB" Margin="0,0,0,12"/>

                <Grid Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="32"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Border Background="#2563EB" Width="24" Height="24" CornerRadius="12">
                        <TextBlock Text="1" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock Grid.Column="1" Text="In the Palworld main menu, click 'Join Multiplayer Game'." VerticalAlignment="Center" FontSize="13" Foreground="#D1D5DB"/>
                </Grid>

                <Grid Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="32"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Border Background="#2563EB" Width="24" Height="24" CornerRadius="12">
                        <TextBlock Text="2" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock Grid.Column="1" Text="Look at the direct connection box at the bottom of the screen." VerticalAlignment="Center" FontSize="13" Foreground="#D1D5DB"/>
                </Grid>

                <Grid Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="32"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Border Background="#2563EB" Width="24" Height="24" CornerRadius="12">
                        <TextBlock Text="3" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="Paste the server address (Ctrl+V):" FontSize="13" Foreground="#D1D5DB"/>
                        <Border Background="#0B0D13" Padding="8,4" CornerRadius="4" Margin="0,4,0,0" HorizontalAlignment="Left">
                            <TextBlock Name="TxtServerAddress" Text="100.x.x.x:8211" FontWeight="Bold" Foreground="#38BDF8" FontFamily="Consolas" FontSize="14"/>
                        </Border>
                    </StackPanel>
                </Grid>

                <Grid Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="32"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Border Background="#2563EB" Width="24" Height="24" CornerRadius="12">
                        <TextBlock Text="4" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="Enter the server password when prompted:" FontSize="13" Foreground="#D1D5DB"/>
                        <Border Background="#0B0D13" Padding="8,4" CornerRadius="4" Margin="0,4,0,0" HorizontalAlignment="Left">
                            <TextBlock Name="TxtServerPassword" Text="••••••••" FontWeight="Bold" Foreground="#FBBF24" FontFamily="Consolas" FontSize="14"/>
                        </Border>
                    </StackPanel>
                </Grid>

                <Grid Margin="0,0,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="32"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Border Background="#10B981" Width="24" Height="24" CornerRadius="12">
                        <TextBlock Text="5" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock Grid.Column="1" Text="Click 'Connect' and enjoy the game!" VerticalAlignment="Center" FontSize="13" Foreground="#D1D5DB"/>
                </Grid>
            </StackPanel>
        </Border>

        <!-- Buttons -->
        <Grid Grid.Row="2">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                <Button Content="Copy Address Again" Click="BtnCopyAddress_Click" Background="#1E293B" Foreground="#93C5FD" Padding="12,8" Margin="0,0,8,0" Cursor="Hand" BorderThickness="0">
                    <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="6"/></Style></Button.Resources>
                </Button>
                <Button Content="Copy Password" Name="BtnCopyPassword" Click="BtnCopyPassword_Click" Background="#1E293B" Foreground="#FDE68A" Padding="12,8" Cursor="Hand" BorderThickness="0">
                    <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="6"/></Style></Button.Resources>
                </Button>
            </StackPanel>

            <Button Content="Got it / Close" HorizontalAlignment="Right" Click="BtnClose_Click" Background="#2563EB" Foreground="White" FontWeight="Bold" Padding="20,8" Cursor="Hand" BorderThickness="0">
                <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="6"/></Style></Button.Resources>
            </Button>
        </Grid>
    </Grid>
</Window>
