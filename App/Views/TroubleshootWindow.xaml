<Window x:Class="HemzPalworldConnectionSetup.Views.TroubleshootWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Hemz Palworld - Connection Troubleshooter"
        Height="680" Width="820"
        WindowStartupLocation="CenterOwner"
        Background="#0F1117" Foreground="#F3F4F6"
        FontFamily="Segoe UI"
        ResizeMode="CanResizeWithGrip">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="#1A1D27" CornerRadius="8" Padding="16" Margin="0,0,0,16" BorderBrush="#2D3348" BorderThickness="1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock Text="DIAGNOSTIC TROUBLESHOOTING ENGINE" FontWeight="Bold" FontSize="18" Foreground="#60A5FA"/>
                    <TextBlock Text="Automatic 12-point health audit of Tailscale network, server device, and game client." Foreground="#9CA3AF" FontSize="12" Margin="0,4,0,0"/>
                </StackPanel>
                <Button Grid.Column="1" Name="BtnRerun" Content="Rerun Diagnostics" Click="BtnRerun_Click"
                        Background="#2563EB" Foreground="White" FontWeight="SemiBold" Padding="14,8"
                        Cursor="Hand" BorderThickness="0">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="6"/>
                        </Style>
                    </Button.Resources>
                </Button>
            </Grid>
        </Border>

        <!-- Diagnostic Items List -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <ItemsControl Name="ItemsDiagnosticList">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Background="#161923" CornerRadius="6" Padding="14" Margin="0,0,0,10" BorderBrush="#242938" BorderThickness="1">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="36"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <!-- Status Icon -->
                                <Border Grid.Column="0" Width="26" Height="26" CornerRadius="13" Background="{Binding StatusColor}" HorizontalAlignment="Left" VerticalAlignment="Top">
                                    <TextBlock Text="{Binding StatusIcon}" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="12"/>
                                </Border>

                                <!-- Details -->
                                <StackPanel Grid.Column="1" Margin="8,0,0,0">
                                    <TextBlock Text="{Binding Title}" FontWeight="Bold" FontSize="14" Foreground="#E5E7EB"/>
                                    <TextBlock Text="{Binding Details}" Foreground="#9CA3AF" FontSize="12" Margin="0,3,0,0" TextWrapping="Wrap"/>
                                    <Border Margin="0,8,0,0" Padding="10,6" Background="#1E2333" CornerRadius="4" Visibility="{Binding RecommendationVisibility}">
                                        <TextBlock Text="{Binding Recommendation}" Foreground="#FBBF24" FontSize="11" TextWrapping="Wrap"/>
                                    </Border>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <!-- Footer -->
        <Border Grid.Row="2" Margin="0,16,0,0" Padding="0">
            <Grid>
                <Button Content="Open Diagnostic Log" HorizontalAlignment="Left" Click="BtnOpenLog_Click"
                        Background="#2D3348" Foreground="#D1D5DB" Padding="12,7" BorderThickness="0" Cursor="Hand">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="6"/>
                        </Style>
                    </Button.Resources>
                </Button>
                <Button Content="Close" HorizontalAlignment="Right" Click="BtnClose_Click"
                        Background="#374151" Foreground="White" Padding="20,7" BorderThickness="0" Cursor="Hand">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="6"/>
                        </Style>
                    </Button.Resources>
                </Button>
            </Grid>
        </Border>
    </Grid>
</Window>
